.git
.gitignore
.venv
.pytest_cache
.mypy_cache
.ruff_cache
__pycache__
*.pyc
*.pyo
*.pyd
.env
.make-flow
# frontend/ entra al contexto: la primera etapa de Dockerfile.backend compila
# la SPA. Solo se excluyen los artefactos locales, que se regeneran adentro.
frontend/node_modules/
frontend/dist/
frontend/coverage/
landing/
tests/*
# tests/fixtures es lectura runtime para el dashboard de eval (shapes JSON).
!tests/fixtures
!tests/fixtures/**
node_modules/
