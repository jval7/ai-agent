FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv==0.6.2

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY src ./src
# scripts/ provee `personas` y `coverage` consumidos por
# `src/services/use_cases/eval_query_service.py`. tests/fixtures/profiles/
# provee los AgentProfile JSON de los shapes que el dashboard expone.
# Ambas son lecturas read-only en runtime — la frontera scripts/tests → src
# es deliberada y solo aplica al subsistema de eval (gated por
# EVAL_ENDPOINTS_ENABLED).
COPY scripts ./scripts
COPY tests/fixtures ./tests/fixtures

ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONPATH=/app

EXPOSE 8000

CMD ["uvicorn", "src.entrypoints.web.main:app", "--host", "0.0.0.0", "--port", "8000"]
